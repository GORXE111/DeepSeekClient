{
  "name": "deepseek-client",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面客户端：装上就能用，只需配置 API 或本地模型。",
  "license": "MIT",
  "author": "linyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GORXE111/DeepSeekClient.git"
  },
  "main": "main.js",
  "bin": {
    "deepseek-client": "bin/cli.js"
  },
  "files": [
