{
  "name": "deepseek-client-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Client 全套源码：harness（前端+后端）与 Electron 壳同仓库。",
  "license": "MIT",
  "author": "linyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GORXE111/DeepSeekClient.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run setup:harness && npm run setup:desktop",
    "setup:harness": "npx pnpm -C harness install",
    "setup:desktop": "npm --prefix desktop install",
    "build:harness": "npx pnpm -C harness run build",
    "build:runtime": "node tools/build-runtime.js",
    "build:win": "npm --prefix desktop run build:win",
    "build:mac": "npm --prefix desktop run build:mac",
    "build:linux": "npm --prefix desktop run build:linux",
    "build": "npm run build:harness && npm run build:runtime && npm run build:win",
    "start": "npm --prefix desktop start",
    "test": "node desktop/test/pet-anim.test.js",
    "test:harness": "npx pnpm -C harness run test",
    "lint:harness": "npx pnpm -C harness run lint",
    "typecheck:harness": "npx pnpm -C harness run typecheck"
  }
}
